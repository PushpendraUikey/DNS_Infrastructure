$TTL 3600
@       IN  SOA root-ns. admin.cs6008. (
                2026102001  ; serial
                3600        ; refresh
                900         ; retry
                604800      ; expire
                3600 )      ; minimum

@       IN  NS  root-ns.
root-ns. IN A   172.16.3.10

; delegate the com zone to tld-ns
com.        IN  NS  ns.com.
ns.com.     IN  A   172.16.3.20
